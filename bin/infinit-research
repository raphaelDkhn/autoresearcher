#!/usr/bin/env bash
# Runs the experiment controller bundled with this plugin on the first Python 3.9+ it finds.
# Several candidates, because a pyenv shim fails inside a project pinned to a Python it lacks.
set -euo pipefail

src="$(cd "$(dirname "${BASH_SOURCE[0]}")/../src" && pwd)"
for python in python3 /usr/bin/python3 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    if "$python" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
        exec "$python" -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from infinit_research.cli import main; sys.exit(main())' "$src" ${1+"$@"}
    fi
done
echo "infinit-research: needs Python 3.9 or newer (python3)" >&2
exit 127
